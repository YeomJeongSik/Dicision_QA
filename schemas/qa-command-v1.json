{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loopback QA command v1",
  "type": "object",
  "required": ["schema_version", "session_id", "request_id", "deadline_ms", "world_generation", "expected_mapping_revision", "input_owner", "owner_revision"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 3000},
    "world_generation": {"type": "integer", "minimum": 1},
    "expected_mapping_revision": {"type": "integer", "minimum": 1},
    "expected_observation_seq": {"type": "integer", "minimum": 0},
    "input_owner": {"enum": ["MANUAL", "DECISIONS", "SCRIPTED"]},
    "owner_revision": {"type": "integer", "minimum": 1},
    "keys": {"$ref": "#/$defs/keys"},
    "hold_ms": {"type": "integer", "minimum": 20, "maximum": 2000},
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 3000},
    "timeline": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "integer", "minimum": 0, "maximum": 3000},
          {"enum": ["down", "up"]},
          {"type": "string", "minLength": 1}
        ],
        "minItems": 3,
        "items": false
      }
    },
    "steps": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/step"}}
  },
  "oneOf": [
    {"required": ["keys", "hold_ms"], "not": {"anyOf": [{"required": ["steps"]}, {"required": ["timeline"]}, {"required": ["duration_ms"]}]}},
    {"required": ["steps"], "not": {"anyOf": [{"required": ["keys"]}, {"required": ["hold_ms"]}, {"required": ["timeline"]}, {"required": ["duration_ms"]}]}},
    {"required": ["timeline", "duration_ms"], "not": {"anyOf": [{"required": ["keys"]}, {"required": ["hold_ms"]}, {"required": ["steps"]}]}}
  ],
  "$defs": {
    "keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "range": {
      "type": "object",
      "properties": {
        "min": {"type": "integer"}, "default": {"type": "integer"},
        "max": {"type": "integer"}, "value": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["tap", "hold", "down", "up", "parallel", "wait", "key_tap", "key_hold", "key_down", "key_up"]},
        "keys": {"$ref": "#/$defs/keys"},
        "fkey": {"type": "string", "minLength": 1},
        "logical_action": {"type": "string", "minLength": 1},
        "duration_ms": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 2000}, {"$ref": "#/$defs/range"}]},
        "repeat": {"$ref": "#/$defs/range"},
        "gap_ms": {"$ref": "#/$defs/range"}
      },
      "if": {"properties": {"kind": {"const": "wait"}}},
      "then": {"not": {"anyOf": [{"required": ["keys"]}, {"required": ["fkey"]}, {"required": ["logical_action"]}]}},
      "else": {"oneOf": [{"required": ["keys"]}, {"required": ["fkey"]}, {"required": ["logical_action"]}]}
    }
  }
}
